# ==============================================================================
# MysteryStay — Environment Variables Template
# Copy this file to .env and populate with production credentials
# ==============================================================================

# Database Configuration (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mysterystay_dev
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password
DB_ROOT_PASSWORD=your_secure_root_password

# JWT Security (Must be a 256-bit cryptographically secure hex/base64 string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# CORS Configuration (Comma-separated allowed origin patterns)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app,https://mysterystay.vercel.app

# Payment Gateway — UPI Scan & Pay
UPI_VPA=6302714896@mbk
UPI_PAYEE_NAME=MysteryStay Prive
UPI_CURRENCY=INR
UPI_USD_TO_INR=85.00
UPI_EXPIRY_MINUTES=15

# Payment Gateway — Razorpay Sandbox
RAZORPAY_KEY_ID=rzp_test_MysteryStayDemoKey
RAZORPAY_KEY_SECRET=MysteryStaySecretSandbox2026
RAZORPAY_WEBHOOK_SECRET=MysteryStayWebhookSecret2026
RAZORPAY_CURRENCY=USD

# Frontend Public API Base URL (Used during Vite build)
VITE_API_BASE_URL=https://mysterystay-backend.onrender.com/api/v1
